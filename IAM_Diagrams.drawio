        <mxCell id="i-scope" value="Record scope:&#10;who, since when, txn ID, impact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="i-ev" value="Capture expected vs actual at each hop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="i-hops" value="Trace one transaction across hops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dc2626;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="180" width="760" height="120" as="geometry" /></mxCell>
        <mxCell id="h1" value="Client /&#10;browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="h2" value="Network&#10;DNS / LB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="h3" value="IAM&#10;service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="h4" value="Connector /&#10;directory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="800" y="220" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="h5" value="Target&#10;system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="950" y="220" width="120" height="50" as="geometry" /></mxCell>
        <mxCell id="i-iso" value="Isolate FIRST failed hop&#10;(compare to known-good user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="i-fix" value="Smallest reversible fix&#10;keep rollback path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="i-retest" value="Re-test: success + denial + lifecycle + reconcile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="i-doc" value="Document root cause &amp; prevention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="ie1" style="html=1;endArrow=block;" edge="1" parent="1" source="i-start" target="i-scope"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie2" style="html=1;endArrow=block;" edge="1" parent="1" source="i-scope" target="i-ev"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie3" style="html=1;endArrow=block;" edge="1" parent="1" source="i-ev" target="i-hops"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ieh1" style="html=1;endArrow=block;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ieh2" style="html=1;endArrow=block;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ieh3" style="html=1;endArrow=block;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ieh4" style="html=1;endArrow=block;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie4" style="html=1;endArrow=block;" edge="1" parent="1" source="i-hops" target="i-iso"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie5" style="html=1;endArrow=block;" edge="1" parent="1" source="i-iso" target="i-fix"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie6" style="html=1;endArrow=block;" edge="1" parent="1" source="i-fix" target="i-retest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ie7" style="html=1;endArrow=block;" edge="1" parent="1" source="i-retest" target="i-doc"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
