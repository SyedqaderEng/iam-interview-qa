        <mxCell id="s-idpl" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="s-idp"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="700" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m1" value="1. Request protected resource" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="150" as="sourcePoint" /><mxPoint x="510" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. Redirect with AuthnRequest (ACS URL, ID, RelayState)" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="200" as="sourcePoint" /><mxPoint x="150" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3. Deliver AuthnRequest to SSO URL" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="250" as="sourcePoint" /><mxPoint x="880" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4. Authenticate user + evaluate MFA/policy" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="300" as="sourcePoint" /><mxPoint x="960" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5. Signed SAML assertion (HTTP-POST) + RelayState" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="360" as="sourcePoint" /><mxPoint x="150" y="360" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6. POST assertion to ACS URL" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="410" as="sourcePoint" /><mxPoint x="510" y="410" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7. Verify signature, issuer, audience, recipient, InResponseTo, timestamps" style="html=1;endArrow=block;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="470" as="sourcePoint" /><mxPoint x="590" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8. Create session, redirect to resource" style="html=1;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="530" as="sourcePoint" /><mxPoint x="150" y="530" as="targetPoint" /></mxGeometry></mxCell>
      </root>
